<Project>
  <!-- Package versions for every project in this repository (NuGet central package management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="EasyQuery and EasyData">
    <PackageVersion Include="EasyData.Exporters.ClosedXML" Version="1.6.0" />
    <PackageVersion Include="EasyData.Exporters.PdfSharp" Version="1.6.0" />
    <PackageVersion Include="Korzh.EasyQuery.AspNetCore" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.DataExport" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.EntityFrameworkCore.Identity" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.EntityFrameworkCore.Relational" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.SqLiteGate" Version="7.5.0" />
    <PackageVersion Include="Korzh.EasyQuery.SqlServerGate" Version="7.5.0" />
  </ItemGroup>
  <ItemGroup Label="Other packages">
    <PackageVersion Include="Korzh.DbUtils.Import" Version="1.4.3" />
    <PackageVersion Include="Korzh.DbUtils.Sqlite" Version="1.4.3" />
    <PackageVersion Include="Korzh.DbUtils.SqlServer" Version="1.4.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageVersion Include="NuGet.Common" Version="6.14.3" />
    <PackageVersion Include="NuGet.Protocol" Version="6.14.3" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>
</Project>
